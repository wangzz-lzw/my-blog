generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  READER
}

model User {
  id           String   @id @default(cuid())
  username     String?  @unique
  email        String?  @unique
  name         String?
  avatar       String? // 头像：URL 或 data URL（客户端压缩后上传）
  passwordHash String
  role         Role     @default(READER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model EmailCode {
  id        String   @id @default(cuid())
  email     String // 统一小写存储
  purpose   String // "register" | "bind"
  codeHash  String // sha256(code + AUTH_SECRET + email + purpose)，不存明文
  attempts  Int      @default(0)
  ip        String? // 仅用于限流，不用于其它用途
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([email, purpose, createdAt])
  @@index([ip, createdAt])
}

model Post {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String    @db.Text // Markdown 正文
  cover       String? // 封面图 URL
  published   Boolean   @default(false)
  publishedAt DateTime?
  views       Int       @default(0) // 浏览量（client beacon 自增）
  tags        Tag[]
  comments    Comment[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  aliases   String[] @default([]) // 被替换掉的旧 slug：旧地址靠它永久跳转
  createdAt DateTime @default(now())
  posts     Post[]
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    String
  email     String?
  content   String   @db.Text
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([postId, approved])
}

/// 图床里的图片记录（见 openspec: image-library）。
///
/// 图片本身存在 OSS 的 img/<sha256>.<ext>，这里只记元信息。
/// 内容寻址意味着同一张图只有一个 key，所以 key 唯一就够了，重复上传走 upsert 合并。
model Image {
  id          String   @id @default(cuid())
  key         String   @unique // img/<sha256>.<ext>，页面经 /img/<key> 代理访问
  hash        String // sha256，搜索与去重判断用
  ext         String // jpg / png / webp / gif
  contentType String
  bytes       Int
  width       Int? // 头部解析失败时留空，不阻断上传
  height      Int?
  usage       String   @default("image") // 最近一次用途：avatar | cover | image
  uploaderId  String? // 不做外键：用户注销后图片仍在，记录不该随之消失
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime @default(now())

  @@index([createdAt])
  @@index([usage, createdAt])
  @@index([hash])
}

/// 站内问答用的文档块（见 openspec: add-ai-qa）。
///
/// 每篇已发布文章按 h2/h3 切成若干块，提问时先检索命中块，再让模型只依据这些块作答。
/// 两块检索实现共用这张表：全文检索走 text + GIN 索引，向量检索走 embedding 列。
///
/// embedding 用 Unsupported：pgvector 是可选扩展，本地 Windows 的 PG 18 装不上它，
/// 声明成 vector(1024) 会让没有扩展的库连客户端都生成不出来。所以：
///   - Prisma 里它是一个不参与类型检查的列（读写都走 $queryRaw / $executeRaw）；
///   - 迁移里用 DO $$ ... EXCEPTION ... $$ 包住，没有扩展时跳过而不是让整条迁移失败。
/// 维度 1024 由 qwen3.7-text-embedding-flash 实测确定。
model DocChunk {
  id        String   @id @default(cuid())
  postId    String
  slug      String // 冗余一份，检索命中后直接拼链接，不用再 join
  postTitle String // 同上：回答里要显示来源标题
  order     Int // 文章内第几块，从 0 开始
  heading   String? // 所属小节标题；块首也会带上，供模型理解上下文
  text      String   @db.Text
  chars     Int // 字数，用于切块质量检查与统计
  /// 向量列：存在但 Prisma 不管理其类型，读写都走原生 SQL
  embedding Unsupported("vector(1024)")?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([postId, order])
  @@index([postId])
  @@index([slug])
}
