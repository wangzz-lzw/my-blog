generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  READER
}

model User {
  id           String   @id @default(cuid())
  username     String?  @unique
  email        String?  @unique
  name         String?
  avatar       String? // 头像：URL 或 data URL（客户端压缩后上传）
  passwordHash String
  role         Role     @default(READER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model EmailCode {
  id        String   @id @default(cuid())
  email     String // 统一小写存储
  purpose   String // "register" | "bind"
  codeHash  String // sha256(code + AUTH_SECRET + email + purpose)，不存明文
  attempts  Int      @default(0)
  ip        String? // 仅用于限流，不用于其它用途
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([email, purpose, createdAt])
  @@index([ip, createdAt])
}

model Post {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String    @db.Text // Markdown 正文
  cover       String? // 封面图 URL
  published   Boolean   @default(false)
  publishedAt DateTime?
  views       Int       @default(0) // 浏览量（client beacon 自增）
  tags        Tag[]
  comments    Comment[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  aliases   String[] @default([]) // 被替换掉的旧 slug：旧地址靠它永久跳转
  createdAt DateTime @default(now())
  posts     Post[]
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    String
  email     String?
  content   String   @db.Text
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([postId, approved])
}
