# PostgreSQL 连接串（本地开发）
DATABASE_URL="postgresql://blog:blog_password@localhost:5432/blog?schema=public"
# NextAuth 加密密钥，用 `openssl rand -base64 32` 生成，切勿泄露
AUTH_SECRET="replace_with_a_32byte_random_base64_secret"
# 站点对外地址
AUTH_URL="http://localhost:3000"

# 初始管理员账号（prisma seed 首次运行时创建）
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change_me_to_a_strong_password"

# AI 功能（选填，OpenAI 兼容接口；不填则后台「AI 生成」不可用）
# 示例：DeepSeek  AI_BASE_URL="https://api.deepseek.com/v1"  AI_MODEL="deepseek-chat"
AI_API_KEY=""
AI_BASE_URL=""
AI_MODEL=""

# 阿里云 OSS（图片上传：头像 / 文章封面）
# OSS_REGION 示例：oss-cn-hangzhou、oss-cn-beijing、oss-cn-shanghai
OSS_REGION=""
OSS_BUCKET="lzw-personal-chief"
OSS_ACCESS_KEY_ID=""
OSS_ACCESS_KEY_SECRET=""
OSS_ENDPOINT=""
OSS_PUBLIC_BASE_URL=""
OSS_ACL="public-read"
