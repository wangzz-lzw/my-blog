# PostgreSQL 连接串（本地开发）
DATABASE_URL="postgresql://blog:blog_password@localhost:5432/blog?schema=public"
# NextAuth 加密密钥，用 `openssl rand -base64 32` 生成，切勿泄露
AUTH_SECRET="replace_with_a_32byte_random_base64_secret"
# 站点对外地址
AUTH_URL="http://localhost:3000"

# 初始管理员账号（prisma seed 首次运行时创建）
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change_me_to_a_strong_password"
