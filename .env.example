# PostgreSQL 连接串（本地开发）
DATABASE_URL="postgresql://blog:blog_password@localhost:5432/blog?schema=public"
# NextAuth 加密密钥，用 `openssl rand -base64 32` 生成，切勿泄露
AUTH_SECRET="replace_with_a_32byte_random_base64_secret"
# 站点对外地址
AUTH_URL="http://localhost:3000"

# 初始管理员账号（prisma seed 首次运行时创建）
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change_me_to_a_strong_password"

# AI 功能（选填，OpenAI 兼容接口；不填则后台「AI 生成」与站内问答不可用）
# 示例：DeepSeek  AI_BASE_URL="https://api.deepseek.com/v1"  AI_MODEL="deepseek-chat"
AI_API_KEY=""
AI_BASE_URL=""
AI_MODEL=""

# Embedding（选填，站内问答的向量检索用）
# 三项缺一即自动回落全文检索；与上面的 AI_* 分开配，可以用不同供应商。
# 阿里云百炼（DashScope）实测可用的配置：
#   base 必须带 /compatible-mode —— 写成 /api/v1 会 404（不是模型名的问题）
#   模型 qwen3.7-text-embedding-flash：维度 1024，支持批量输入，相同文本返回一致
# 模型决定向量维度，维度会写进迁移的 vector(1024)，换模型需重算全部向量。
EMBEDDING_API_KEY=""
EMBEDDING_BASE_URL="https://cn-beijing.maas.qianwenaiapi.com/compatible-mode/v1"
EMBEDDING_MODEL="qwen3.7-text-embedding-flash"

# 阿里云 OSS（图片上传：头像 / 文章封面）
# OSS_REGION 示例：oss-cn-hangzhou、oss-cn-beijing、oss-cn-shanghai
OSS_REGION=""
OSS_BUCKET="lzw-personal-chief"
OSS_ACCESS_KEY_ID=""
OSS_ACCESS_KEY_SECRET=""
OSS_ENDPOINT=""
OSS_PUBLIC_BASE_URL=""
OSS_ACL="public-read"
